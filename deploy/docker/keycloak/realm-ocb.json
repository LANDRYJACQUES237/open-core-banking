{
  "realm": "ocb",
  "displayName": "Open Core Banking (developpement)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "ledger:post",
      "description": "Portee ledger:post, porteuse de l'audience ledger-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-ledger-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ledger-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "ledger:read",
      "description": "Portee ledger:read, porteuse de l'audience ledger-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-ledger-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ledger-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "payment:initiate",
      "description": "Portee payment:initiate, porteuse de l'audience payment-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-payment-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "payment-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "payment:read",
      "description": "Portee payment:read, porteuse de l'audience payment-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-payment-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "payment-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "provider:read",
      "description": "Portee provider:read, porteuse de l'audience provider-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-provider-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "provider-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "notification:read",
      "description": "Portee notification:read, porteuse de l'audience notification-service.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-notification-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "notification-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [],
  "clients": [
    {
      "clientId": "payment-service",
      "description": "Compte de service du moteur de paiement. Seul detenteur de ledger:post : aucun marchand ne peut passer d'ecriture comptable. Porte aussi ledger:read, parce que l'interdiction de decouvert exige de lire le solde du portefeuille avant d'engager les fonds.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-payment-service",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "ledger:post",
        "ledger:read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "merchant-demo",
      "description": "Marchand de demonstration. Demande des encaissements, des decaissements et des transferts ; ne touche jamais au grand livre.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-merchant-demo",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "payment:initiate",
        "payment:read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "merchant-second",
      "description": "Second marchand. Existe pour une seule raison : demontrer que deux appelants qui choisissent la meme cle d'idempotence obtiennent deux transactions distinctes, et non celle de l'autre.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-merchant-second",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "payment:initiate",
        "payment:read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "ops-console",
      "description": "Exploitation. Lecture seule, sur les trois surfaces de diagnostic.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-ops-console",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "ledger:read",
        "provider:read",
        "notification:read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ]
}
