# Copier en .env et renseigner. Le .env n'est jamais versionne (voir .gitignore).
#
# Deux utilisateurs distincts, volontairement :
#   - LEDGER_DB_MIGRATION_USER possede le schema et applique les migrations ;
#   - LEDGER_DB_USER fait tourner l'application et ne recoit que SELECT et INSERT
#     sur le journal, donc ne peut ni modifier ni supprimer une ecriture.
# Les confondre reviendrait a donner a l'application le pouvoir de retirer ses
# propres garde-fous.

LEDGER_DB_URL=jdbc:postgresql://localhost:5432/ledger
LEDGER_DB_USER=ledger_app
LEDGER_DB_PASSWORD=changez-moi
LEDGER_DB_MIGRATION_USER=ledger_owner
LEDGER_DB_MIGRATION_PASSWORD=changez-moi-aussi

# Nom du role applicatif auquel la migration V5 accorde les droits.
LEDGER_APP_ROLE=ledger_app

LEDGER_PORT=8081
LEDGER_DB_POOL_SIZE=10
LEDGER_LOG_LEVEL=INFO
