# Copier en .env et renseigner. Le .env n'est jamais versionne (voir .gitignore).
#
# Deux utilisateurs distincts, volontairement :
#   - LEDGER_DB_MIGRATION_USER possede le schema et applique les migrations ;
#   - LEDGER_DB_USER fait tourner l'application et ne recoit que SELECT et INSERT
#     sur le journal, donc ne peut ni modifier ni supprimer une ecriture.
# Les confondre reviendrait a donner a l'application le pouvoir de retirer ses
# propres garde-fous.

LEDGER_DB_URL=jdbc:postgresql://localhost:5432/ledger
LEDGER_DB_USER=ledger_app
LEDGER_DB_PASSWORD=changez-moi
LEDGER_DB_MIGRATION_USER=ledger_owner
LEDGER_DB_MIGRATION_PASSWORD=changez-moi-aussi

# Nom du role applicatif auquel la migration V5 accorde les droits.
LEDGER_APP_ROLE=ledger_app

LEDGER_PORT=8081
LEDGER_DB_POOL_SIZE=10
LEDGER_LOG_LEVEL=INFO

# --- Phase 3 : securite OIDC -----------------------------------------------------
# Fournisseur d'identite. Chaque service valide les jetons localement via JWKS :
# pas d'appel au fournisseur a chaque requete, donc pas de point de defaillance
# unique sur le chemin de l'argent.
OIDC_ISSUER_URI=http://localhost:8090/realms/ocb
OIDC_TOKEN_URI=http://localhost:8090/realms/ocb/protocol/openid-connect/token

# Adresse des cles publiques. La renseigner rend la resolution PARESSEUSE : le service ne
# contacte le fournisseur d'identite qu'au premier jeton recu, et non a son demarrage.
# Sans elle, un Keycloak indisponible empeche tout service de demarrer — donc de redemarrer
# au moment precis ou on en aurait besoin.
OIDC_JWK_SET_URI=http://localhost:8090/realms/ocb/protocol/openid-connect/certs

# Compte de service de payment-service, seul detenteur de la portee ledger:post.
LEDGER_CLIENT_ID=payment-service
LEDGER_CLIENT_SECRET=changez-moi

# Secrets de signature des webhooks, un par operateur.
# Aucune valeur par defaut cote application : un secret vide validerait toute
# signature calculee avec une chaine vide, soit une protection affichee mais
# inexistante. L'absence de configuration fait echouer la verification.
MTN_WEBHOOK_SECRET=changez-moi
ORANGE_WEBHOOK_SECRET=changez-moi

# --- Phase 3 : provider-service --------------------------------------------------
PROVIDER_DB_URL=jdbc:postgresql://localhost:5434/provider
PROVIDER_DB_USER=provider_app
PROVIDER_DB_PASSWORD=changez-moi
PROVIDER_DB_MIGRATION_USER=provider_owner
PROVIDER_DB_MIGRATION_PASSWORD=changez-moi-aussi
PROVIDER_APP_ROLE=provider_app
PROVIDER_PORT=8083
PROVIDER_CALLBACK_BASE_URL=http://localhost:8083
MTN_API_BASE_URL=http://localhost:9101
ORANGE_API_BASE_URL=http://localhost:9102

# --- Phase 4 : notification-service ----------------------------------------------
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5435/notification
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=changez-moi
NOTIFICATION_DB_MIGRATION_USER=notification_owner
NOTIFICATION_DB_MIGRATION_PASSWORD=changez-moi-aussi
NOTIFICATION_APP_ROLE=notification_app
NOTIFICATION_PORT=8084
